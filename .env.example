# Copy to .env and fill in. Never commit .env.

VINGO_DATABASE_URL=postgresql+psycopg://vingo:vingo@localhost:5432/vingo_scraper

# Run headless in production; set false to watch a session debug.
VINGO_HEADLESS=true
VINGO_LOG_LEVEL=INFO

# Rate discipline. Raising these is the fastest way to burn the account pool.
VINGO_MIN_DELAY_S=3.0
VINGO_MAX_DELAY_S=8.0
VINGO_MAX_PAGES_PER_ACCOUNT_PER_DAY=50

# Image rehosting is OFF by default. Turning it on means republishing
# sellers' photos -- a separate, explicitly agreed decision. See README.
VINGO_REHOST_IMAGES=false

# Optional: alert destination for canary/breakage notifications.
# VINGO_ALERT_WEBHOOK=https://hooks.slack.com/services/...
