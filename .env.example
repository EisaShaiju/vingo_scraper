# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Apify
# ---------------------------------------------------------------------------
# Token from https://console.apify.com/settings/integrations
VINGO_APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VINGO_APIFY_ACTOR_ID=apify/facebook-marketplace-scraper

# Apify bills per result (~$0.005/item), so a typo in --max-items is a billing
# incident. This is the hard ceiling applied regardless of what a caller asks.
VINGO_APIFY_MAX_ITEMS_HARD_CAP=2000
VINGO_APIFY_TIMEOUT_S=900

# ---------------------------------------------------------------------------
# Supabase Postgres -- TWO urls, and they are NOT interchangeable
# ---------------------------------------------------------------------------
# Runtime: transaction pooler, port 6543. IPv4, but NO prepared statements --
# psycopg3 must run with prepare_threshold=0 or you get intermittent failures
# under load. See docs/supabase.md.
VINGO_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Migrations: session pooler / direct, port 5432. Alembic needs a real session.
# Direct connections are IPv6-only unless the project has the IPv4 add-on --
# on an IPv4-only machine use the session pooler host here.
VINGO_DATABASE_MIGRATION_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Supabase Storage
# ---------------------------------------------------------------------------
VINGO_SUPABASE_URL=https://<ref>.supabase.co

# SERVICE ROLE key -- bypasses RLS. Server-side only.
# Never put this in a client bundle, a frontend env var, or a repo.
VINGO_SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

VINGO_STORAGE_BUCKET=listing-images

# ---------------------------------------------------------------------------
# Media pipeline
# ---------------------------------------------------------------------------
# Facebook CDN urls expire within hours-to-days, so images are rehosted during
# ingestion rather than by a later batch job.
VINGO_MAX_IMAGE_BYTES=10485760
VINGO_IMAGE_DOWNLOAD_TIMEOUT_S=30
VINGO_IMAGE_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Ops
# ---------------------------------------------------------------------------
VINGO_LOG_LEVEL=INFO
# VINGO_ALERT_WEBHOOK=https://hooks.slack.com/services/...

# Independent spend ceiling, enforced by Apify server-side.
VINGO_APIFY_MAX_CHARGE_USD=25.0
