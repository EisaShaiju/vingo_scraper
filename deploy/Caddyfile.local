# Password gate for the Cloudflare Tunnel path.
#
# Caddy listens on localhost only and cloudflared points at IT rather than at
# uvicorn, so the tunnel cannot expose the app without a password. No TLS here:
# Cloudflare terminates it at their edge, and this hop never leaves the VM.
#
# Use this file INSTEAD of deploy/Caddyfile when there is no external IP --
# which is the case on comet-vm, where the subnet forbids one.
#
#   sudo cp deploy/Caddyfile.local /etc/caddy/Caddyfile
#   sudo sed -i 's|REPLACE_HASH|'"$(caddy hash-password)"'|' /etc/caddy/Caddyfile
#   sudo systemctl restart caddy

:8080 {
	encode zstd gzip

	basic_auth {
		vingo REPLACE_HASH
	}

	reverse_proxy 127.0.0.1:8000 {
		# A collect can wait ~45s on Apify. The 30s default would cut it off
		# mid-run, after Apify had charged -- the exact failure the two-phase
		# tick exists to prevent, reintroduced one layer up.
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
